.ONESHELL:

MIRI_SYSROOT ?= /home/zjp/.cache/miri
MIRI_BIN ?= $(shell rustc --print sysroot)/bin/miri
MIRI_FLAGS ?= -Zmiri-disable-stacked-borrows

.PHONY: config
config:
	export ARCH=x86_64
	export LLVM=1
	make rustavailable
	make LLVM=1 allnoconfig
	./scripts/config --enable RUST
	./scripts/config --enable MODULES
	./scripts/config --enable SAMPLES
	./scripts/config --enable SAMPLES_RUST
	./scripts/config --module SAMPLE_RUST_MINIMAL
	./scripts/config --enable KUNIT
	# Enable serial output for qemu.
	./scripts/config --enable PRINTK
	./scripts/config --enable SERIAL_8250
	./scripts/config --enable SERIAL_8250_CONSOLE
	# Enable initramfs decomporession for qemu.
	./scripts/config --enable BLK_DEV_INITRD
	./scripts/config --enable RD_GZIP
	./scripts/config --enable DEVTMPFS
	./scripts/config --enable DEVTMPFS_MOUNT
	# allnoconfig may disable executable format loaders; without these,
	# /init or /bin/sh in initramfs fails with "error -8" (ENOEXEC).
	./scripts/config --enable BINFMT_ELF
	./scripts/config --enable BINFMT_SCRIPT
	make olddefconfig
	make savedefconfig

.PHONY: build
build: config
	make RUSTC=miri LLVM=1 ARCH=x86_64 -j"$$(nproc)"

.PHONY: run
run: build
	qemu-system-x86_64 \
		-m 2048 -smp 2 \
		-display none \
		-serial mon:stdio \
		-no-reboot \
		-kernel arch/x86/boot/bzImage \
		-initrd /tmp/initramfs-rust.cpio.gz \
		-append "console=ttyS0,115200 earlycon=ttyS0,115200 rdinit=/init loglevel=8 panic=-1"

rust-analyzer: config
	make LLVM=1 rust-analyzer

test:
	./tools/testing/kunit/kunit.py run --make_options LLVM=1 --arch x86_64 --kconfig_add CONFIG_RUST=y

.PHONY: miri
miri: config
	MIRI_SYSROOT=$(MIRI_SYSROOT) \
	make LLVM=1 ARCH=x86_64 miri-kernel-test RUSTC=rustc MIRI_RUSTC=$(MIRI_BIN) MIRI_FLAGS="$(MIRI_FLAGS)" HOSTRUSTC=rustc
